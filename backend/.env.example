# Required in production. Settings has no defaults for these:
# APP_NAME, APP_VERSION, ENVIRONMENT, DEBUG, DATABASE_URL,
# FRONTEND_URL, ACCESS_TOKEN_EXPIRE_MINUTES, SECRET_KEY, ALGORITHM
#
# TEST_DATABASE_URL is only required for pytest. Leave it unset in production.

APP_NAME=Billax 2.0 API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/billax
TEST_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/billax_test
FRONTEND_URL=http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=30
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
